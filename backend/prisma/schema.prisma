generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(uuid())
  telegramId  String   @unique
  username    String?
  balance     Int      @default(0)
  miningRate  Int      @default(1)  // coins per interval
  lastMineAt  DateTime @default(now())
  createdAt   DateTime @default(now())
}
